# nginx.conf.example — Nginx reverse proxy config for SportsCast AI
#
# SportsCast AI analysis pipeline takes 60–90 seconds per fresh analysis.
# The critical setting is proxy_read_timeout: must be at least 120s or Nginx
# will return 504 Gateway Timeout while the pipeline is still running.
#
# Usage:
#   Copy the server block below into your Nginx sites-available config.
#   Replace yourdomain.com with your actual domain.
#   Adjust SSL cert paths if using HTTPS (recommended for production).

server {
    listen 80;
    server_name yourdomain.com;

    # ── React frontend (built static files) ──────────────────────────────────
    location / {
        root /var/www/sportscast-ai/ui-react/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # ── FastAPI backend ───────────────────────────────────────────────────────
    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;

        # CRITICAL: analysis pipeline takes 60-90s; must exceed this
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;

        # SSE / streaming support (for job status polling)
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection '';
        chunked_transfer_encoding on;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # If serving API and frontend on the same domain without /api/ prefix,
    # point the root location directly to FastAPI and serve the React app
    # from a subdomain or separate server block instead.
}
