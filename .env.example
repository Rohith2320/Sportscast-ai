# ─────────────────────────────────────────────────────────────────────────────
# SportsCast AI — Environment Variables
# Copy this file to .env and fill in your values before starting the server.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Anthropic API key — used by match analysis, player analysis, enrichment,
# and narrative agents (Claude Sonnet 4.6 / Opus 4.8)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key — used by the chat agent (GPT-4o-mini)
OPENAI_API_KEY=sk-proj-...

# ── OPTIONAL — FEATURES ──────────────────────────────────────────────────────

# BSD API key — used by the soccer fetcher (Premier League data, free tier).
# The app starts fine without it, but soccer analysis will fail (every
# /analyze and /discover call for sport=soccer errors out) until it's set.
BSD_API_KEY=...

# ElevenLabs API key — enables AI voice commentary on the analysis page.
# If not set, the frontend falls back to the browser's Web Speech API.
ELEVENLABS_API_KEY=sk_...

# Riot API key — used in tests to verify Valorant data access.
# The Valorant fetcher uses the free VLR community API (no key required).
RIOT_API_KEY=RGAPI-...

# ── OPTIONAL — OBSERVABILITY ─────────────────────────────────────────────────

# LangSmith tracing — set LANGCHAIN_API_KEY to enable pipeline traces.
# LANGCHAIN_TRACING_V2 must be "true" to activate tracing.
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=sportscast-ai

# ── OPTIONAL — MEMORY ────────────────────────────────────────────────────────

# Mem0 persistent memory for the chat agent.
# Set to "true" to enable cross-session memory (requires mem0ai to be configured).
MEM0_ENABLED=false

# ── OPTIONAL — ADDITIONAL NBA DATA ───────────────────────────────────────────

# RapidAPI and BallDontLie keys for supplemental NBA stats (used in tests only).
# The main pipeline uses the nba_api library which requires no API key.
RAPIDAPI_KEY=...
BALLDONTLIE_API_KEY=...

# ── FRONTEND ─────────────────────────────────────────────────────────────────

# Production API URL for the React frontend build.
# When deploying, set this to your FastAPI server URL (e.g. https://api.yourdomain.com).
# For local development, defaults to http://localhost:8000 — no need to set this.
# VITE_API_URL=https://api.yourdomain.com
